---
// uno4.work landing v3 (2026-09-24). Standalone page with its own <head>; /careers and /download keep Layout.astro.
const jsonLd = {"@context":"https://schema.org","@type":"SoftwareApplication","name":"Uno Work","applicationCategory":"ProductivityApplication","operatingSystem":"macOS, Windows, Web","url":"https://uno4.work/","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"publisher":{"@type":"Organization","name":"Uno4 Labs LLC","url":"https://uno4.dev"}};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#5b5be8" />
  <title>Uno Work — Work with AI on your own computer</title>
  <meta name="description" content="Uno Work is where you work with AI on your own computer. Make a project, tell the AI how you work, add skills and connectors, message it from Telegram or Slack. Use Uno AI or your own Claude, ChatGPT or OpenCode subscription." />
  <link rel="canonical" href="https://uno4.work/" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:site_name" content="Uno Work" />
  <meta property="og:title" content="Uno Work — Work with AI on your own computer" />
  <meta property="og:description" content="Projects, instructions, skills and connectors on your own computer in the cloud, always online. Uno AI or your own subscription. The app is free on Mac, PC and in the browser." />
  <meta property="og:url" content="https://uno4.work/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://uno4.work/assets/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Uno Work: work with AI on your own computer" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Uno Work — Work with AI on your own computer" />
  <meta name="twitter:description" content="Projects, instructions, skills and connectors on a computer that's yours. The app is free on Mac, PC and in the browser." />
  <meta name="twitter:image" content="https://uno4.work/assets/og.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://console.uno4.dev" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <style is:global>
    :root {
      --violet: #5b5be8; --violet-deep: #4343c9; --violet-ink: #3a3ab8; --tint: #f0f0fc; --vline: #dcdcf8; --band: #4a4ad6;
      --ink: #18181b; --ink-2: #55555e; --ink-3: #6b6b74; --paper: #fff; --bg: #fafafb; --line: #e7e7ec; --line-2: #d8d8e0;
      --ok: #1b8a4b; --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace; --ease: cubic-bezier(.16,1,.3,1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    [hidden] { display: none !important; }
    html { color-scheme: light; scroll-behavior: smooth; scroll-padding-top: 72px; scrollbar-color: #c9c9da var(--bg); }
    html::-webkit-scrollbar { width: 12px; }
    html::-webkit-scrollbar-track { background: var(--bg); }
    html::-webkit-scrollbar-thumb { background: #cfcfe0; border-radius: 12px; border: 3px solid var(--bg); }
    html::-webkit-scrollbar-thumb:hover { background: var(--violet); }
    body { background: var(--paper); color: var(--ink); font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; font-size: 16px; line-height: 1.55; -webkit-font-smoothing: antialiased; overflow-x: hidden; caret-color: var(--violet); font-feature-settings: "cv11", "ss01"; }
    ::selection { background: var(--violet); color: #fff; }
    a { color: inherit; text-decoration: none; }
    a.u { color: var(--violet-ink); text-decoration: underline; text-decoration-color: var(--vline); text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
    a.u:hover { text-decoration-color: var(--violet); }
    :focus-visible { outline: 2px solid var(--violet); outline-offset: 3px; border-radius: 4px; }
    button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
    .mono { font-family: var(--mono); }
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .skip { position: absolute; left: 16px; top: -60px; z-index: 50; background: var(--ink); color: #fff; padding: 8px 14px; border-radius: 8px; font-size: 14px; font-weight: 600; }
    .skip:focus { top: 12px; }
    svg.i { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
    .wrap { max-width: 1184px; margin: 0 auto; padding: 0 32px; }

    /* Nav */
    .nav { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.88); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); border-bottom: 1px solid transparent; transition: border-color .2s; }
    .nav.scrolled { border-bottom-color: var(--line); }
    .nav-in { display: flex; align-items: center; justify-content: space-between; height: 64px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; }
    .brand img { width: 26px; height: 26px; display: block; border-radius: 7px; box-shadow: 0 1px 2px rgba(24,24,27,.18); }
    .brand-text { font-weight: 650; font-size: 15px; letter-spacing: -.01em; }
    .nav-right { display: flex; align-items: center; gap: 26px; }
    .nav-link { font-size: 14px; font-weight: 500; color: var(--ink-2); transition: color .15s; }
    .nav-link:hover { color: var(--ink); }
    .nav-cta { font-size: 13.5px; font-weight: 600; color: #fff; background: var(--ink); padding: 8px 15px; border-radius: 8px; transition: background .15s; }
    .nav-cta:hover { background: var(--violet-deep); }

    .btn { display: inline-flex; align-items: center; gap: 9px; font-size: 15.5px; font-weight: 600; padding: 13px 22px; border-radius: 10px; transition: background .15s, transform .15s, box-shadow .15s, border-color .15s; }
    .btn .i { width: 16px; height: 16px; stroke-width: 2; }
    .btn-primary { background: var(--violet); color: #fff; border: 1px solid var(--violet-deep); box-shadow: 0 1px 2px rgba(24,24,27,.12), 0 8px 22px -10px rgba(91,91,232,.6); }
    .btn-primary:hover { background: var(--violet-deep); transform: translateY(-1px); }
    .btn-ghost { color: var(--ink); border: 1px solid var(--line-2); background: #fff; }
    .btn-ghost:hover { border-color: var(--ink-3); }

    /* Hero */
    .hero { padding: 64px 0 0; background: linear-gradient(180deg, #fff 0%, #fff 40%, #f5f5fb 100%); }
    .hero-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; align-items: end; }
    .hero h1 { font-size: clamp(42px, 6vw, 78px); font-weight: 720; letter-spacing: -.042em; line-height: .99; text-wrap: balance; }
    .hero h1 span { color: var(--violet); }
    .hero-lede { font-size: 19px; color: var(--ink-2); max-width: 40ch; }
    .hero-lede b { color: var(--ink); font-weight: 600; }
    .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
    .hero-note { margin-top: 14px; font-size: 13.5px; color: var(--ink-3); }

    /* Window chrome (shared by hero + step mocks) */
    .win { background: #fff; border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; box-shadow: 0 2px 6px rgba(24,24,27,.05), 0 40px 90px -40px rgba(58,58,184,.4); }
    .win-bar { display: grid; grid-template-columns: 90px 1fr 90px; align-items: center; height: 38px; padding: 0 14px; background: #f6f6f9; border-bottom: 1px solid var(--line); }
    .dots { display: flex; gap: 7px; }
    .dots i { width: 11px; height: 11px; border-radius: 50%; background: #dcdce3; }
    .url { justify-self: center; display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--ink-2); background: #fff; border: 1px solid var(--line); border-radius: 7px; padding: 3px 14px; white-space: nowrap; }
    .url .i { width: 11px; height: 11px; }

    /* Hero shot: Uno Work Home replica */
    .shot { margin-top: 56px; }
    .shot .win { border-radius: 14px 14px 0 0; border-bottom: 0; }
    .app { display: grid; grid-template-columns: 250px 1fr; height: 600px; font-size: 13.5px; }
    .side { border-right: 1px solid var(--line); padding: 14px 10px; display: flex; flex-direction: column; gap: 4px; background: #fff; min-width: 0; }
    .side-brand { display: flex; align-items: center; gap: 8px; padding: 4px 8px 12px; font-weight: 650; font-size: 14.5px; }
    .side-brand .bm { width: 20px; height: 20px; border-radius: 6px; }
    .alpha { font-size: 9px; font-weight: 700; letter-spacing: .08em; color: var(--violet-ink); background: var(--tint); border-radius: 5px; padding: 1px 6px; }
    .machine { display: flex; align-items: center; gap: 9px; padding: 8px; border-radius: 9px; }
    .machine b { display: block; font-weight: 600; font-size: 13.5px; }
    .machine small { display: block; font-size: 11.5px; color: var(--ink-3); }
    .machine .chev { margin-left: auto; color: var(--ink-3); }
    .machine .chev .i { width: 14px; height: 14px; }
    .on { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); flex: none; }
    .live { animation: live 5.2s ease-in-out infinite; }
    @keyframes live { 0%,100% { box-shadow: 0 0 0 0 rgba(31,157,85,0); } 50% { box-shadow: 0 0 0 4px rgba(31,157,85,.18); } }
    .item { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; color: var(--ink); font-weight: 500; }
    .item .i { width: 16px; height: 16px; }
    .item.act { background: #f1f1f4; }
    .item .st { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--ink-3); }
    .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; padding: 3px; margin: 4px 0; background: #f4f4f7; border-radius: 9px; }
    .seg span { display: flex; align-items: center; justify-content: center; gap: 5px; padding: 5px 0; font-size: 12px; color: var(--ink-2); border-radius: 7px; }
    .seg span .i { width: 12px; height: 12px; }
    .seg span.act { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(24,24,27,.08); }
    .lbl { font-size: 10.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); padding: 12px 10px 4px; }
    .chat { padding: 7px 10px; border-radius: 8px; min-width: 0; }
    .chat small { display: block; font-size: 10.5px; color: var(--ink-3); }
    .chat span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; }
    .chat.run span::after { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--violet); margin-left: 6px; vertical-align: 1px; }
    .main { background: #fcfcfd; overflow: hidden; min-width: 0; }
    .topbar { display: flex; align-items: center; gap: 8px; height: 46px; padding: 0 20px; border-bottom: 1px solid var(--line); background: #fff; font-weight: 500; }
    .topbar .i { width: 16px; height: 16px; color: var(--ink-2); }
    .pane { max-width: 820px; margin: 0 auto; padding: 22px 28px; }
    .card { background: linear-gradient(180deg, #f7f7fe, #fff 60%); border: 1px solid var(--line); border-radius: 16px; padding: 20px 22px; }
    .card-head { display: flex; gap: 16px; align-items: flex-start; }
    .card-ico { width: 46px; height: 46px; border-radius: 12px; background: #e8e8fb; color: var(--violet-ink); display: grid; place-items: center; flex: none; }
    .card-ico .i { width: 22px; height: 22px; }
    .cname { font-size: 19px; font-weight: 650; letter-spacing: -.02em; display: flex; align-items: center; gap: 8px; }
    .pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 500; color: var(--ink); border: 1px solid var(--line-2); border-radius: 999px; padding: 1px 8px; background: #fff; letter-spacing: 0; }
    .cmeta { font-size: 12.5px; color: var(--ink-2); margin-top: 3px; }
    .caddr { font-family: var(--mono); font-size: 12px; color: var(--ink-2); margin-top: 4px; }
    .cacts { margin-left: auto; display: flex; gap: 6px; }
    .ub { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 500; border: 1px solid var(--line-2); border-radius: 8px; background: #fff; padding: 5px 10px; white-space: nowrap; }
    .ub .i { width: 13px; height: 13px; }
    .ub.v { background: var(--violet); color: #fff; border-color: var(--violet-deep); }
    .bars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 18px; }
    .bar > div { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--ink-2); margin-bottom: 6px; font-variant-numeric: tabular-nums; }
    .bar i { display: block; height: 5px; border-radius: 5px; background: #ececf2; position: relative; overflow: hidden; }
    .bar i::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--v); background: var(--violet); border-radius: 5px; }
    .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 14px; font-size: 12px; color: var(--ink-2); }
    .sec { display: flex; justify-content: space-between; align-items: center; margin: 22px 2px 12px; font-weight: 600; font-size: 14px; }
    .progs { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; }
    .prog { text-align: center; font-size: 11.5px; min-width: 0; }
    .prog .t { width: 48px; height: 48px; border-radius: 13px; margin: 0 auto 7px; display: grid; place-items: center; color: #fff; box-shadow: 0 1px 2px rgba(24,24,27,.1), inset 0 1px rgba(255,255,255,.25); position: relative; }
    .prog .t .i { width: 22px; height: 22px; }
    .prog .t img { width: 30px; height: 30px; object-fit: contain; }
    .prog .t.img { background: #fff; border: 1px solid var(--line); }
    .prog b { display: block; font-weight: 600; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .prog small { color: var(--ink-3); font-size: 10.5px; }
    .prog .t.run::after { content: ""; position: absolute; right: -2px; bottom: -2px; width: 10px; height: 10px; border-radius: 50%; background: var(--ok); border: 2px solid #fcfcfd; }
    .t-uno { background: linear-gradient(135deg, #7474f2, #4343c9); }
    .t-files { background: linear-gradient(135deg, #3aa0f5, #1b7fe0); }
    .t-term { background: linear-gradient(135deg, #3b3b44, #18181b); }
    .t-store { background: linear-gradient(135deg, #c152f0, #9a2fd8); }
    .t-site { background: linear-gradient(135deg, #2fb98a, #16926a); }
    .cloud { display: flex; align-items: center; gap: 12px; margin-top: 16px; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; }
    .cloud .ci { width: 32px; height: 32px; border-radius: 9px; background: #e8f3fd; color: #1b7fe0; display: grid; place-items: center; flex: none; }
    .cloud b { font-weight: 600; }
    .cloud .bar { flex: 1; max-width: 260px; }
    .cloud .go { margin-left: auto; font-size: 12.5px; color: var(--ink-2); white-space: nowrap; }

    /* Two ways */
    .used { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; padding: 28px 0 0; font-size: 13.5px; color: var(--ink-3); }
    .used ul { display: flex; gap: 28px; list-style: none; flex-wrap: wrap; }
    .used li { display: inline-flex; align-items: center; gap: 9px; font-weight: 600; color: var(--ink-2); font-size: 14.5px; }
    .used img { height: 24px; width: auto; border-radius: 6px; }
    .ways { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--ink); margin-top: 40px; }
    .way { padding: 30px 40px 6px 0; display: grid; grid-template-rows: auto auto 1fr; gap: 8px; }
    .way + .way { padding-left: 40px; padding-right: 0; border-left: 1px solid var(--line); }
    .way h3 { font-size: 24px; font-weight: 700; letter-spacing: -.028em; line-height: 1.15; }
    .way p { color: var(--ink-2); font-size: 16px; max-width: 42ch; }
    .way-vis { margin-top: 18px; align-self: end; }
    .dock { display: flex; gap: 14px; flex-wrap: wrap; }
    .dock .prog { width: 64px; }
    .mini-chat { display: grid; gap: 8px; max-width: 420px; }
    .mc-me { justify-self: end; background: var(--violet); color: #fff; border-radius: 14px 14px 4px 14px; padding: 8px 12px; font-size: 14px; max-width: 86%; }
    .mc-ai { display: flex; gap: 9px; align-items: flex-start; font-size: 14px; color: var(--ink); }
    .mc-ai .av { width: 24px; height: 24px; border-radius: 7px; background: linear-gradient(135deg, #7474f2, #4343c9); color: #fff; display: grid; place-items: center; flex: none; }
    .mc-ai .av .i { width: 13px; height: 13px; }
    .mc-ai span { background: #fff; border: 1px solid var(--line); border-radius: 4px 14px 14px 14px; padding: 8px 12px; }

    .section { padding: 112px 0; }
    .section.alt { background: var(--bg); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .head { max-width: 760px; margin-bottom: 44px; }
    h2.title { font-size: clamp(32px, 4.2vw, 52px); font-weight: 720; letter-spacing: -.035em; line-height: 1.04; text-wrap: balance; }
    .lead { margin-top: 14px; font-size: 18px; color: var(--ink-2); max-width: 60ch; }

    /* How it works: steps */
    .steps { display: grid; grid-template-columns: 330px minmax(0, 1fr); gap: 48px; align-items: start; }
    .step-list { list-style: none; display: grid; border-top: 1px solid var(--ink); }
    .step-tab { width: 100%; text-align: left; display: grid; grid-template-columns: 30px 1fr; gap: 2px 12px; padding: 16px 10px 16px 0; border-bottom: 1px solid var(--line); position: relative; transition: color .2s; }
    .step-tab .n { grid-row: span 2; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--line-2); display: grid; place-items: center; font-size: 12.5px; font-weight: 650; color: var(--ink-3); font-variant-numeric: tabular-nums; transition: background .25s, border-color .25s, color .25s; }
    .step-tab b { font-size: 16px; font-weight: 640; letter-spacing: -.012em; color: var(--ink-2); transition: color .2s; }
    .step-tab small { font-size: 14px; color: var(--ink-3); line-height: 1.45; }
    .step-tab:hover b { color: var(--ink); }
    .step-tab[aria-selected="true"] b { color: var(--ink); }
    .step-tab[aria-selected="true"] .n { background: var(--violet); border-color: var(--violet); color: #fff; }
    .step-tab[aria-selected="true"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--violet); }
    .step-tab:focus-visible { outline-offset: -2px; }
    .stage { position: relative; }
    .panel > .win { min-height: 480px; }
    .panel { display: none; }
    .panel.is-active { display: block; animation: reveal .6s var(--ease) both; }
    @keyframes reveal { from { opacity: 0; filter: blur(6px); transform: translateY(10px); } to { opacity: 1; filter: blur(0); transform: none; } }
    .panel-head { display: none; }
    .stage-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; font-size: 14px; color: var(--ink-3); }
    .stage-nav .btns { display: flex; gap: 8px; }
    .icon-btn { width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line-2); background: #fff; display: grid; place-items: center; color: var(--ink); transition: border-color .15s, color .15s; }
    .icon-btn:hover { border-color: var(--violet); color: var(--violet-ink); }
    .icon-btn:disabled { opacity: .4; cursor: default; border-color: var(--line-2); color: var(--ink); }
    .icon-btn .i { width: 16px; height: 16px; stroke-width: 2; }

    /* Step mock layout */
    .mock { display: grid; grid-template-columns: 190px minmax(0, 1fr); min-height: 440px; font-size: 13.5px; }
    .mside { border-right: 1px solid var(--line); padding: 14px 10px; background: #fff; display: grid; align-content: start; gap: 2px; }
    .mside .lbl { padding-top: 4px; }
    .proj { display: flex; align-items: center; gap: 9px; padding: 7px 9px; border-radius: 8px; color: var(--ink-2); font-weight: 500; white-space: nowrap; }
    .proj .i { width: 15px; height: 15px; }
    .proj.act { background: var(--tint); color: var(--violet-ink); font-weight: 600; }
    .proj.new { color: var(--violet-ink); }
    .mmain { background: #fcfcfd; padding: 22px 26px; min-width: 0; }
    .mh { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
    .mh h4 { font-size: 17px; font-weight: 650; letter-spacing: -.02em; }
    .mh .r { margin-left: auto; }
    .mh .crumb { font-size: 12.5px; color: var(--ink-3); }
    .field { display: grid; gap: 6px; margin-bottom: 14px; }
    .field > span { font-size: 12.5px; font-weight: 600; color: var(--ink-2); }
    .input { border: 1px solid var(--line-2); background: #fff; border-radius: 9px; padding: 9px 12px; font-size: 14px; display: flex; align-items: center; gap: 8px; min-width: 0; }
    .input.focus { border-color: var(--violet); box-shadow: 0 0 0 3px rgba(91,91,232,.14); }
    .caret { width: 1.5px; height: 16px; background: var(--violet); animation: blink 1.1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .popts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .popt { border: 1px solid var(--line-2); background: #fff; border-radius: 10px; padding: 10px 12px; display: grid; gap: 2px; font-size: 13px; }
    .popt b { font-weight: 600; display: flex; align-items: center; gap: 7px; }
    .popt b .i { width: 15px; height: 15px; color: var(--ink-2); }
    .popt small { color: var(--ink-3); font-size: 12px; }
    .popt.sel { border-color: var(--violet); background: #f7f7fe; box-shadow: 0 0 0 3px rgba(91,91,232,.1); }
    .popt.sel b .i { color: var(--violet); }
    .mfoot { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
    .editor { background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .ed-tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); background: #f7f7fa; padding: 0 8px; }
    .ed-tabs span { font-family: var(--mono); font-size: 12px; color: var(--ink-3); padding: 8px 10px; }
    .ed-tabs span.act { color: var(--ink); background: #fff; border: 1px solid var(--line); border-bottom-color: #fff; border-radius: 7px 7px 0 0; margin-bottom: -1px; }
    .code { font-family: var(--mono); font-size: 12.5px; line-height: 1.75; padding: 12px 0; counter-reset: ln; }
    .code div { display: grid; grid-template-columns: 34px 1fr; padding-right: 14px; }
    .code div::before { counter-increment: ln; content: counter(ln); text-align: right; padding-right: 12px; color: #b5b5c2; }
    .code .h { color: var(--violet-ink); font-weight: 500; }
    .code .m { color: var(--ink-3); }
    .note { margin-top: 12px; font-size: 12.5px; color: var(--ink-2); display: flex; align-items: center; gap: 8px; }
    .note .i { width: 15px; height: 15px; color: var(--violet); }
    .rows { background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .rowx { display: flex; align-items: center; gap: 12px; padding: 12px 14px; }
    .rowx + .rowx { border-top: 1px solid #efeff3; }
    .rowx .lg { width: 32px; height: 32px; border-radius: 9px; border: 1px solid var(--line); background: #fff; display: grid; place-items: center; flex: none; }
    .rowx .lg svg { width: 20px; height: 20px; }
    .rowx .lg.sk { background: var(--tint); border-color: var(--vline); color: var(--violet-ink); }
    .rowx .lg.sk .i { width: 16px; height: 16px; }
    .rowx .tx { min-width: 0; }
    .rowx .tx b { display: block; font-weight: 600; font-size: 13.5px; }
    .rowx .tx small { display: block; color: var(--ink-3); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rowx .r { margin-left: auto; flex: none; }
    .pill-soon { font-size: 11px; font-weight: 600; color: var(--violet-ink); background: var(--tint); border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
    .state { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--ok); }
    .tgl { width: 30px; height: 18px; border-radius: 999px; background: var(--violet); position: relative; flex: none; display: block; }
    .tgl::after { content: ""; position: absolute; right: 2px; top: 2px; width: 14px; height: 14px; border-radius: 50%; background: #fff; }
    .tgl.off { background: #d6d6df; }
    .tgl.off::after { right: auto; left: 2px; }
    .tgl.lock { background: #a9a9f3; }
    .soon { display: flex; align-items: center; gap: 10px; margin-top: 12px; padding: 10px 14px; border: 1px dashed var(--line-2); border-radius: 10px; font-size: 12.5px; color: var(--ink-3); }
    .soon .i { width: 15px; height: 15px; }
    .soon em { font-style: normal; margin-left: auto; font-size: 11px; font-weight: 600; color: var(--violet-ink); background: var(--tint); border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
    .msgs { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: center; min-height: 480px; padding: 28px; background: var(--tint); border: 1px solid var(--vline); border-radius: 14px; }
    .phone { background: #e9eff5; border-radius: 22px; padding: 12px; border: 6px solid var(--ink); }
    .phone .who { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 12.5px; margin-bottom: 10px; }
    .phone .who img { width: 22px; height: 22px; border-radius: 7px; }
    .phone .who small { display: block; font-weight: 400; color: var(--ink-3); font-size: 10.5px; }
    .phone .me { margin: 0 0 8px auto; width: fit-content; max-width: 84%; background: #d9f2c3; border-radius: 10px 10px 3px 10px; padding: 6px 10px; font-size: 12.5px; }
    .phone .it { width: fit-content; max-width: 88%; background: #fff; border-radius: 10px 10px 10px 3px; padding: 6px 10px; font-size: 12.5px; box-shadow: 0 1px 1px rgba(0,0,0,.06); }
    .phone .it + .me { margin-top: 8px; }
    .phone .att { display: flex; align-items: center; gap: 7px; margin-top: 6px; padding: 6px 8px; background: #f3f6f9; border-radius: 8px; font-size: 11.5px; }
    .slack { background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; font-size: 12.5px; align-self: start; }
    .slack .sh { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-bottom: 1px solid var(--line); font-weight: 650; }
    .slack .sh svg { width: 16px; height: 16px; }
    .sm { display: grid; grid-template-columns: 28px 1fr; gap: 9px; padding: 10px 12px; }
    .sm .a { width: 28px; height: 28px; border-radius: 7px; background: #e6d7f0; color: #5a2a7a; display: grid; place-items: center; font-weight: 700; font-size: 12px; }
    .sm .a.bot { background: none; }
    .sm .a.bot img { width: 28px; height: 28px; border-radius: 7px; }
    .sm b { font-weight: 650; }
    .sm b small { font-weight: 400; color: var(--ink-3); margin-left: 5px; font-size: 11px; }
    .sm p { color: var(--ink); margin-top: 1px; }
    .sm .tag { color: #1264a3; background: #e8f3fb; border-radius: 3px; padding: 0 3px; }
    .drop { border: 1.5px dashed #b9b9e8; background: #f7f7fe; border-radius: 12px; padding: 16px; display: flex; align-items: center; gap: 12px; color: var(--violet-ink); font-weight: 600; font-size: 14px; }
    .drop .i { width: 22px; height: 22px; }
    .drop small { display: block; font-weight: 400; color: var(--ink-3); font-size: 12px; }
    .up { margin-top: 12px; }
    .upbar { width: 90px; height: 5px; border-radius: 5px; background: #ececf2; position: relative; overflow: hidden; display: block; }
    .upbar::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--v); background: var(--violet); }
    .doc { width: 24px; height: 28px; border-radius: 4px; display: grid; place-items: center; font-size: 9.5px; font-weight: 800; color: #fff; flex: none; }
    .doc.w { background: #2b6cd8; } .doc.x { background: #1f8f4e; } .doc.p { background: #d4572a; } .doc.f { background: #c23a3a; } .doc.z { background: #6b6b74; }

    /* Outcome: a computer that can do anything */
    .outcome { margin-top: 88px; padding-top: 40px; border-top: 1px solid var(--line); }
    .outcome h3 { font-size: clamp(26px, 3vw, 36px); font-weight: 720; letter-spacing: -.03em; line-height: 1.1; max-width: 22ch; text-wrap: balance; }
    .asks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 32px; }
    .ask { display: flex; flex-direction: column; min-width: 0; }
    .req { align-self: flex-start; max-width: 92%; background: var(--violet); color: #fff; font-size: 14.5px; line-height: 1.45; padding: 10px 14px; border-radius: 16px 16px 16px 5px; box-shadow: 0 8px 20px -12px rgba(58,58,184,.7); }
    .conn { height: 22px; margin-left: 22px; border-left: 1px dashed #b7b7cc; }
    .res { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; font-size: 13px; box-shadow: 0 1px 2px rgba(24,24,27,.04), 0 16px 30px -24px rgba(24,24,27,.35); }
    .res-h { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13px; margin-bottom: 8px; }
    .res-h .ok { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--ok); font-weight: 600; }
    .res-h .ok .i { width: 13px; height: 13px; stroke-width: 2.4; }
    .mini-site { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .mini-site .ms-bar { display: flex; align-items: center; gap: 6px; padding: 5px 8px; background: #f6f6f9; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 11px; color: var(--ink-2); }
    .mini-site .ms-body { padding: 10px 12px; display: flex; justify-content: space-between; align-items: center; gap: 8px; background: linear-gradient(135deg, #fff7ee, #fff); }
    .mini-site b { font-size: 15px; letter-spacing: -.01em; font-weight: 750; color: #6b3e12; }
    .mini-site small { display: block; font-size: 11px; color: #8a6a4a; }
    .mini-site .bk { font-size: 11px; font-weight: 600; background: #6b3e12; color: #fff; border-radius: 6px; padding: 4px 8px; white-space: nowrap; }
    .tg { background: #eef3f8; border-radius: 10px; padding: 10px; }
    .tg .msg { background: #fff; border-radius: 10px 10px 10px 3px; padding: 7px 10px; font-size: 12.5px; box-shadow: 0 1px 1px rgba(0,0,0,.06); }
    .tg .msg b { display: block; color: #2a7ab8; font-size: 11.5px; }
    .tg .msg time { display: block; text-align: right; font-size: 10px; color: var(--ink-3); }
    .sheet { width: 100%; border-collapse: collapse; font-size: 11.5px; font-variant-numeric: tabular-nums; }
    .sheet th, .sheet td { border: 1px solid #e3eee7; padding: 3px 7px; text-align: left; }
    .sheet th { background: #eef7f1; color: #1d6b3f; font-weight: 600; }
    .sheet td:last-child, .sheet th:last-child { text-align: right; }
    .chips { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 40px; }
    .chips > span { font-size: 14px; color: var(--ink-3); margin-right: 6px; }
    .chip { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 500; padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--line-2); transition: border-color .15s, color .15s; }
    .chip:hover { border-color: var(--violet); color: var(--violet-ink); }
    .chip .i { width: 14px; height: 14px; color: var(--violet); }

    /* Pick your AI */
    .ai-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 64px; align-items: center; }
    .ai-points { display: grid; border-top: 1px solid var(--ink); }
    .ai-point { padding: 22px 0; border-bottom: 1px solid var(--line); }
    .ai-point h3 { font-size: 19px; font-weight: 680; letter-spacing: -.02em; }
    .ai-point p { margin-top: 4px; color: var(--ink-2); font-size: 15.5px; max-width: 46ch; }
    .names { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .names span { font-size: 12.5px; font-weight: 600; border: 1px solid var(--line-2); border-radius: 6px; padding: 2px 9px; background: #fff; }
    .picker { background: #fff; border: 1px solid var(--line-2); border-radius: 16px; padding: 22px; box-shadow: 0 2px 6px rgba(24,24,27,.05), 0 40px 80px -44px rgba(58,58,184,.45); }
    .picker h4 { font-size: 18px; font-weight: 680; letter-spacing: -.02em; }
    .picker > p { font-size: 13.5px; color: var(--ink-2); margin-top: 3px; }
    .choices { display: grid; gap: 10px; margin-top: 16px; }
    .choice { display: grid; grid-template-columns: 20px 1fr; gap: 12px; padding: 14px 16px; border: 1px solid var(--line-2); border-radius: 12px; cursor: pointer; transition: border-color .2s, background .2s, box-shadow .2s; }
    .choice:hover { border-color: #b9b9e8; }
    .choice input { appearance: none; width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid #b5b5c2; margin-top: 2px; display: grid; place-items: center; cursor: pointer; }
    .choice input:checked { border-color: var(--violet); }
    .choice input:checked::after { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--violet); }
    .choice input:focus-visible { outline: 2px solid var(--violet); outline-offset: 2px; }
    .choice:has(input:checked) { border-color: var(--violet); background: #f8f8fe; box-shadow: 0 0 0 3px rgba(91,91,232,.1); }
    .choice b { font-weight: 650; font-size: 15px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .choice b em { font-style: normal; font-size: 11px; font-weight: 600; color: var(--violet-ink); background: var(--tint); border-radius: 999px; padding: 1px 8px; }
    .choice small { display: block; color: var(--ink-2); font-size: 13px; margin-top: 2px; }
    .subs { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
    .subs span { font-size: 12px; border: 1px solid var(--line); border-radius: 6px; padding: 1px 8px; color: var(--ink-2); background: #fff; }
    .picker .go { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 18px; font-size: 12.5px; color: var(--ink-3); }
    .picker .go .ub { font-size: 13.5px; padding: 8px 14px; }

    /* App Store shelf */
    .store-facts { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 18px; font-size: 14.5px; color: var(--ink); font-weight: 500; }
    .store-facts span { display: inline-flex; align-items: center; gap: 8px; }
    .store-facts .i { width: 16px; height: 16px; color: var(--violet); stroke-width: 2.1; }
    .shelf { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); list-style: none; }
    .appl { position: relative; text-align: center; padding: 26px 4px 18px; border-bottom: 1px solid var(--line-2); }
    .appl .tile { width: 64px; height: 64px; margin: 0 auto; border-radius: 16px; background: #fff; border: 1px solid var(--line); display: grid; place-items: center; box-shadow: 0 1px 2px rgba(24,24,27,.05), 0 10px 22px -14px rgba(24,24,27,.35); transition: transform .35s var(--ease), box-shadow .35s var(--ease); }
    .appl img { width: 40px; height: 40px; object-fit: contain; display: block; }
    .appl span { display: block; margin-top: 10px; font-size: 12px; font-weight: 500; color: var(--ink-2); line-height: 1.3; }
    .appl:hover .tile { transform: translateY(-3px); box-shadow: 0 1px 2px rgba(24,24,27,.05), 0 16px 28px -14px rgba(58,58,184,.45); }
    .appl:hover span { color: var(--ink); }
    .appl .by { display: block; margin-top: 2px; font-size: 10.5px; color: var(--violet-ink); font-weight: 600; font-style: normal; }
    .store-foot { margin-top: 22px; font-size: 14px; color: var(--ink-3); }

    /* Feature spec rows */
    .frows { border-top: 1px solid var(--ink); }
    .frow { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 56px; align-items: center; padding: 40px 0; border-bottom: 1px solid var(--line); }
    .frow h3 { font-size: 22px; font-weight: 680; letter-spacing: -.025em; line-height: 1.2; }
    .frow p { margin-top: 8px; font-size: 15.5px; color: var(--ink-2); max-width: 44ch; }
    .crop { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 16px; font-size: 13px; box-shadow: 0 1px 2px rgba(24,24,27,.04), 0 24px 50px -34px rgba(58,58,184,.45); min-width: 0; }
    .crop-list { display: grid; }
    .crow { display: flex; align-items: center; gap: 10px; padding: 9px 8px; border-radius: 8px; min-width: 0; }
    .crow + .crow { border-top: 1px solid #f0f0f4; }
    .crow.sel { background: #f3f3fd; border-top-color: transparent; }
    .crow .i { width: 16px; height: 16px; color: var(--ink-2); }
    .crow b { font-weight: 600; }
    .crow small { color: var(--ink-3); font-size: 11.5px; display: block; }
    .crow .r { margin-left: auto; font-size: 12px; color: var(--ink-3); display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
    .sleep { width: 7px; height: 7px; border-radius: 50%; background: #c2c2d0; }
    .share { margin-top: 12px; border: 1px solid var(--vline); background: #fbfbff; border-radius: 10px; padding: 10px 12px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .share .lnk { font-family: var(--mono); font-size: 11.5px; color: var(--ink-2); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .seg2 { display: inline-flex; background: #f1f1f5; border-radius: 7px; padding: 2px; font-size: 11.5px; }
    .seg2 span { padding: 2px 8px; border-radius: 5px; color: var(--ink-2); }
    .seg2 span.act { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(24,24,27,.08); }
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .stat { border: 1px solid var(--line); border-radius: 10px; padding: 9px 11px; font-size: 11.5px; color: var(--ink-2); display: flex; flex-direction: column; gap: 2px; }
    .stat b { font-size: 16px; color: var(--ink); font-variant-numeric: tabular-nums; }
    .stat.sel { background: #f3f3fd; border-color: #c9c9f6; }
    .proc { display: grid; grid-template-columns: 1fr 90px 44px; align-items: center; gap: 12px; padding: 9px 4px; border-top: 1px solid #f0f0f4; font-variant-numeric: tabular-nums; font-size: 12.5px; }
    .proc small { display: block; color: var(--ink-3); font-size: 11px; }
    .proc i { display: block; height: 5px; border-radius: 5px; background: #ececf2; position: relative; overflow: hidden; }
    .proc i::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--v); background: var(--violet); }
    .proc span:last-child { text-align: right; }
    .journal { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); display: grid; gap: 6px; font-size: 12px; }
    .journal div { display: flex; gap: 10px; align-items: center; }
    .journal time { color: var(--ink-3); font-variant-numeric: tabular-nums; width: 70px; flex: none; }

    /* Pricing ladder */
    .price-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 64px; align-items: start; }
    .price-grid .lead { font-size: 17px; }
    .price-links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
    .ladder { list-style: none; border-top: 1px solid var(--ink); }
    .rung { display: grid; grid-template-columns: 76px 64px minmax(0, 1fr) minmax(0, 1.1fr) 104px; gap: 16px; align-items: center; min-height: 84px; padding: 8px 0; border-bottom: 1px solid var(--line); }
    .rung .art { display: grid; place-items: center; height: 76px; }
    .rung .art img { display: block; height: auto; }
    .rung .nm { font-weight: 700; font-size: 16px; letter-spacing: -.01em; }
    .rung .cp { font-weight: 600; font-size: 14.5px; font-variant-numeric: tabular-nums; }
    .rung .cp small, .rung .wk small { display: block; font-weight: 400; font-size: 12px; color: var(--ink-3); }
    .rung .wk { font-size: 14px; color: var(--ink-2); font-weight: 500; }
    .rung .wk.cloudy { color: var(--violet-ink); font-weight: 600; display: flex; align-items: center; gap: 7px; }
    .rung .wk.cloudy::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--violet); flex: none; }
    .rung .pr { text-align: right; font-variant-numeric: tabular-nums; }
    .rung .pr b { font-size: 19px; font-weight: 720; letter-spacing: -.02em; }
    .rung .pr b span { font-size: 12.5px; font-weight: 500; color: var(--ink-3); letter-spacing: 0; }
    .rung .pr small { display: block; font-size: 11.5px; color: var(--ink-3); }
    .rung.rec { background: linear-gradient(90deg, var(--tint), rgba(240,240,252,0)); }
    .rung .badge { display: inline-block; margin-left: 6px; vertical-align: 2px; font-size: 10.5px; font-weight: 650; color: var(--violet-ink); background: #fff; border: 1px solid var(--vline); border-radius: 999px; padding: 0 7px; }
    .ladder-foot { margin-top: 14px; font-size: 13px; color: var(--ink-3); }


    /* Enterprise band — copied from journeys/kit/plan-cards.css (.uno-ent + .uno-plan__cta); tokens mapped to this page. */
    .uno-ent { --uno-violet: var(--violet); --uno-violet-deep: var(--violet-deep); --uno-violet-ink: var(--violet-ink); --uno-violet-tint: var(--tint); --uno-violet-line: var(--vline); --uno-ink: var(--ink); --uno-ink-2: var(--ink-2); --uno-ink-3: var(--ink-3); --uno-paper: var(--paper); --uno-hairline: var(--line); --uno-hairline-strong: var(--line-2); }
    .price-ent { margin-top: 40px; }
    .uno-plan__cta {
      margin-top: auto; display: flex; align-items: center; justify-content: center;
      min-height: 42px; padding: 0 14px; border-radius: 10px;
      font-size: 14px; font-weight: 600; text-decoration: none; color: var(--uno-ink);
      background: var(--uno-paper); border: 1px solid var(--uno-hairline-strong);
      transition: border-color .15s, background .15s, transform .15s, box-shadow .15s;
    }
    .uno-plan__cta:hover { border-color: var(--uno-ink); }
    .uno-plan__cta.is-primary {
      color: #fff; background: var(--uno-violet); border-color: var(--uno-violet-deep);
      box-shadow: 0 1px 2px rgba(24,24,27,.12), 0 6px 20px -8px rgba(91,91,232,.55);
    }
    .uno-plan__cta.is-primary:hover { background: var(--uno-violet-deep); transform: translateY(-1px); }
    .uno-plan__cta:active { transform: translateY(0); }
    .uno-plan__cta:focus-visible { outline: 2px solid var(--uno-violet); outline-offset: 3px; }

    /* ── Enterprise band (under the row of plans, not a sixth column) ──
     * Markup: aside.uno-ent > .uno-ent__art, .uno-ent__head (h3.uno-ent__name + p.uno-ent__for),
     *         dl.uno-ent__specs (4 × div > dt + dd), .uno-ent__act (a.uno-plan__cta.is-primary + small). See ENTERPRISE.md. */
    .uno-ent {
      --uno-art: 104px;
      margin-top: 18px; display: grid; align-items: center;
      grid-template-columns: 112px minmax(0, 300px) minmax(0, 1fr);
      grid-template-areas: "art head specs" "art act specs";
      column-gap: 28px; row-gap: 14px;
      padding: 22px 26px 22px 18px;
      background: var(--uno-paper); border: 1px solid var(--uno-hairline); border-radius: 14px;
    }
    .uno-ent__art { grid-area: art; display: flex; align-items: center; justify-content: center; }
    .uno-ent__art > svg, .uno-ent__art > img { display: block; width: var(--uno-art); height: var(--uno-art); }
    .uno-ent__head { grid-area: head; align-self: end; }
    .uno-ent__name { margin: 0; font-size: 18px; font-weight: 650; letter-spacing: -0.015em; line-height: 1.3; text-wrap: balance; }
    .uno-ent__for { margin: 6px 0 0; font-size: 13px; line-height: 1.45; color: var(--uno-ink-2); text-wrap: pretty; }
    .uno-ent__act { grid-area: act; align-self: start; display: flex; align-items: center; gap: 8px 14px; flex-wrap: wrap; }
    .uno-ent__act .uno-plan__cta { margin: 0; padding: 0 20px; }
    .uno-ent__act small { font-size: 12px; line-height: 1.4; color: var(--uno-ink-3); }
    .uno-ent__specs {
      grid-area: specs; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 28px;
      padding-left: 28px; border-left: 1px solid var(--uno-hairline);
    }
    .uno-ent__specs > div { margin: 0; }
    .uno-ent__specs dt { font-size: 15px; line-height: 1.3; font-weight: 700; letter-spacing: -0.01em; color: var(--uno-ink); }
    .uno-ent__specs dd { margin: 2px 0 0; font-size: 13px; line-height: 1.45; color: var(--uno-ink-2); text-wrap: pretty; }
    @media (max-width: 1040px) {
      .uno-ent { --uno-art: 88px; grid-template-columns: 96px minmax(0, 1fr); grid-template-areas: "art head" "art act" "specs specs"; }
      .uno-ent__specs { padding: 16px 0 0; border-left: 0; border-top: 1px solid var(--uno-hairline); }
    }
    @media (max-width: 560px) {
      .uno-ent { --uno-art: 60px; grid-template-columns: 60px minmax(0, 1fr); grid-template-areas: "art head" "specs specs" "act act"; column-gap: 14px; padding: 18px 16px; align-items: start; }
      .uno-ent__head { align-self: center; }
      .uno-ent__name { font-size: 17px; }
      .uno-ent__specs { grid-template-columns: 1fr; gap: 12px; }
      .uno-ent__act .uno-plan__cta { flex: 1 1 100%; }
    }

    .final { background: var(--band); color: #fff; padding: 104px 0 110px; }
    .final h2 { font-size: clamp(38px, 5.4vw, 68px); font-weight: 720; letter-spacing: -.04em; line-height: 1.02; max-width: 16ch; text-wrap: balance; }
    .final p { margin-top: 18px; font-size: 18px; color: #e3e3fb; max-width: 48ch; }
    .final .row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
    .btn-white { background: #fff; color: var(--violet-ink); border: 1px solid #fff; box-shadow: 0 10px 30px -12px rgba(16,16,70,.6); }
    .btn-white:hover { background: #f4f4ff; transform: translateY(-1px); }
    .btn-line { color: #fff; border: 1px solid rgba(255,255,255,.55); }
    .btn-line:hover { border-color: #fff; }
    .final ::selection { background: #fff; color: var(--violet-ink); }
    .final :focus-visible { outline-color: #fff; }

    footer { padding: 48px 0 36px; border-top: 1px solid var(--line); }
    .foot { display: flex; justify-content: space-between; align-items: flex-start; gap: 32px; flex-wrap: wrap; }
    .foot nav { display: flex; gap: 26px; flex-wrap: wrap; font-size: 14px; color: var(--ink-2); }
    .foot nav a:hover { color: var(--violet-ink); }
    .foot .legal { font-size: 12.5px; color: var(--ink-3); margin-top: 10px; }

    @media (prefers-reduced-motion: reduce) {
      .live, .caret { animation: none; }
      html { scroll-behavior: auto; }
      .panel.is-active { animation: none; }
      .appl .tile, .btn { transition: none; }
    }

    @media (max-width: 1080px) {
      .shelf { grid-template-columns: repeat(5, minmax(0, 1fr)); }
      .progs { grid-template-columns: repeat(4, 1fr); row-gap: 14px; }
      .app { height: auto; }
      .steps { grid-template-columns: 280px minmax(0, 1fr); gap: 32px; }
      .mock { grid-template-columns: minmax(0, 1fr); }
      .mside { display: none; }
      .price-grid { grid-template-columns: 1fr; gap: 32px; }
      .ai-grid { gap: 40px; }
    }
    @media (max-width: 880px) {
      .nav-link.opt { display: none; }
      .hero-grid { grid-template-columns: 1fr; gap: 20px; }
      .app { grid-template-columns: 1fr; }
      .side { display: none; }
      .pane { padding: 16px; }
      .card-head { flex-wrap: wrap; }
      .cacts { margin-left: 0; width: 100%; }
      .bars { grid-template-columns: 1fr; gap: 10px; }
      .ways { grid-template-columns: 1fr; }
      .way, .way + .way { padding: 26px 0 8px; border-left: 0; }
      .way + .way { border-top: 1px solid var(--line); margin-top: 20px; }
      /* Steps: stacked, every step visible */
      .steps { grid-template-columns: 1fr; gap: 0; }
      .step-list, .stage-nav { display: none; }
      .stage { min-height: 0; display: grid; gap: 44px; }
      .panel, .panel.is-active { display: block; animation: none; }
      .panel-head { display: grid; grid-template-columns: 30px 1fr; gap: 2px 12px; margin-bottom: 16px; }
      .panel-head .n { grid-row: span 2; width: 26px; height: 26px; border-radius: 50%; background: var(--violet); color: #fff; display: grid; place-items: center; font-size: 12.5px; font-weight: 650; }
      .panel-head h3 { font-size: 18px; font-weight: 680; letter-spacing: -.015em; line-height: 1.3; }
      .panel-head p { font-size: 14.5px; color: var(--ink-2); }
      .asks { grid-template-columns: 1fr; gap: 28px; }
      .mock, .panel > .win { min-height: 0; }
      .msgs { min-height: 0; padding: 16px; }
      .ai-grid { grid-template-columns: 1fr; }
      .frow { grid-template-columns: 1fr; gap: 22px; padding: 32px 0; }
    }
    @media (max-width: 560px) {
      .wrap { padding: 0 20px; }
      .nav-right { gap: 16px; }
      .hero { padding-top: 40px; }
      .hero-lede { font-size: 17px; }
      .hero-cta .btn { flex: 1 1 auto; justify-content: center; }
      .win-bar { grid-template-columns: 40px 1fr 10px; }
      .dots i:nth-child(n+2) { display: none; }
      .caddr { font-size: 10.5px; word-break: break-all; }
      .card-ico { display: none; }
      .cloud .bar { display: none; }
      .cloud { flex-wrap: wrap; }
      .card-foot { flex-wrap: wrap; }
      .shelf { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .appl { padding: 20px 2px 14px; }
      .appl .tile { width: 56px; height: 56px; border-radius: 14px; }
      .appl img { width: 34px; height: 34px; }
      .section { padding: 80px 0; }
      .mmain { padding: 16px; }
      .popts { grid-template-columns: 1fr; }
      .msgs { grid-template-columns: 1fr; }
      .dock { gap: 6px; }
      .dock .prog { width: 58px; }
      .code { font-size: 11.5px; }
      .code div { grid-template-columns: 26px 1fr; padding-right: 10px; }
      .rowx { padding: 11px 12px; gap: 10px; }
      .stats { grid-template-columns: 1fr 1fr 1fr; }
      .stat b { font-size: 14px; }
      .proc { grid-template-columns: 1fr 60px 38px; }
      .rung { grid-template-columns: 56px minmax(0, 1fr) auto; grid-template-areas: "art nm pr" "art cp pr" "art wk pr"; gap: 0 14px; padding: 14px 0; }
      .rung .art { grid-area: art; height: 60px; }
      .rung .art img { transform: scale(.78); }
      .rung .nm { grid-area: nm; }
      .rung .cp { grid-area: cp; font-size: 13.5px; }
      .rung .cp small { display: none; }
      .rung .wk { grid-area: wk; font-size: 13px; }
      .rung .wk small { display: none; }
      .rung .pr { grid-area: pr; }
      .picker { padding: 18px; }
      .picker .go { flex-direction: column; align-items: stretch; }
      .picker .go .ub { justify-content: center; }
    }
  </style>
</head>
