<script>
  import { fetchLatestRelease, pickReleaseAsset, type ReleasePlatform } from "../lib/releases";

  // Nav: hairline border once the page scrolls.
  const nav = document.getElementById("nav");
  if (nav) {
    const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Steps: vertical tabs (arrow keys, Home/End), prev/next, #step-N deep links.
  {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".step-tab"));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls") ?? ""));
    const prev = document.getElementById("prev") as HTMLButtonElement | null;
    const next = document.getElementById("next") as HTMLButtonElement | null;
    const count = document.getElementById("step-count");
    let cur = 0;
    const show = (i: number, focus = false) => {
      if (i < 0 || i >= tabs.length) return;
      cur = i;
      tabs.forEach((t, k) => {
        const sel = k === i;
        t.setAttribute("aria-selected", sel ? "true" : "false");
        t.tabIndex = sel ? 0 : -1;
        panels[k]?.classList.toggle("is-active", sel);
      });
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === tabs.length - 1;
      if (count) count.textContent = "Step " + (i + 1) + " of " + tabs.length;
      if (focus) tabs[i]?.focus();
    };
    tabs.forEach((t, k) => {
      t.addEventListener("click", () => show(k));
      t.addEventListener("keydown", (e: KeyboardEvent) => {
        const map: Record<string, number> = { ArrowDown: cur + 1, ArrowRight: cur + 1, ArrowUp: cur - 1, ArrowLeft: cur - 1, Home: 0, End: tabs.length - 1 };
        const target = map[e.key];
        if (target !== undefined) { e.preventDefault(); show(Math.max(0, Math.min(tabs.length - 1, target)), true); }
      });
    });
    prev?.addEventListener("click", () => show(cur - 1));
    next?.addEventListener("click", () => show(cur + 1));
    const m = /^#step-([1-6])$/.exec(location.hash);
    if (m) show(Number(m[1]) - 1);
  }

  // AI picker: flips the button between Uno AI and "your subscription".
  {
    const form = document.getElementById("picker") as HTMLFormElement | null;
    const go = document.getElementById("pk-go");
    const note = document.getElementById("pk-note");
    form?.addEventListener("change", () => {
      const own = (form.elements.namedItem("ai") as RadioNodeList | null)?.value === "own";
      if (go) go.textContent = own ? "Connect my subscription" : "Start with Uno AI";
      if (note) note.textContent = own ? "Sign in once on your computer." : "Ready now. No setup.";
    });
  }

  // Download: pick the installer for this platform (shared with /download).
  const ua = navigator.userAgent || "";
  const plat = (navigator as { userAgentData?: { platform?: string } }).userAgentData?.platform || navigator.platform || "";
  const mobile = /Android|iPhone|iPad|iPod/i.test(ua);
  let platform: ReleasePlatform | null = null;
  let label = "Download for Mac or Windows";
  if (!mobile && /Win/i.test(plat + ua)) { platform = "win-x64"; label = "Download for Windows"; }
  else if (!mobile && /Mac/i.test(plat + ua)) { platform = "mac-arm64"; label = "Download for Mac"; }
  document.querySelectorAll(".js-dl-label").forEach((el) => { el.textContent = label; });
  if (platform) {
    const target = platform;
    fetchLatestRelease()
      .then((release) => {
        const asset = release?.assets && pickReleaseAsset(release.assets, target);
        if (!asset) return;
        document.querySelectorAll<HTMLAnchorElement>(".js-dl, .js-dl-nav").forEach((el) => { el.href = asset.browser_download_url; });
      })
      .catch(() => { /* keep the releases page link */ });
  }
</script>
