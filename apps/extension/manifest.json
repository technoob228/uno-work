{
  "manifest_version": 3,
  "name": "Uno Work Companion",
  "version": "0.2.0",
  "description": "Lets Uno Work act in the tabs of this browser — in the sessions you are already signed into.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.uno4.work/*",
        "https://*.uno4.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Uno Work Companion"
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
