[Unit]
Description=Uno Work daemon (web mode)
Documentation=https://uno4.dev/docs/work
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unowork
Group=unowork
WorkingDirectory=/home/unowork
EnvironmentFile=/etc/uno-work/uno-work.env
# Stdout уходит в journald: стартовый owner pairing-токен там не место.
# Токены чеканятся по требованию (`uno-work auth pairing create`).
Environment=T3CODE_STARTUP_PAIRING_OUTPUT=0
# /tmp on a box is a 1 GB tmpfs (and PrivateTmp below makes it per-service).
# Checkpoint git indexes and harness scratch files for a large project filled
# it up ("Out of diskspace"), so every TMPDIR consumer — the daemon and the
# harnesses it spawns — writes to the state disk instead. install.sh creates
# the directory owned by the service user.
Environment=TMPDIR=/var/lib/uno-work/tmp
ExecStart=/opt/uno-work/bin/uno-work serve \
  --mode web \
  --host ${UNO_WORK_HOST} \
  --port ${UNO_WORK_PORT} \
  --base-dir ${UNO_WORK_STATE_DIR} \
  ${UNO_WORK_WORKSPACE}

# Port 80 is below 1024 and the daemon runs unprivileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=2
# The daemon has its own watchdog; systemd restarts it when the health probe
# wedges hard enough to kill the process.
TimeoutStopSec=20
KillSignal=SIGTERM

# Low memory (box 395 hung on 01.09, Dax's build OOM'd a 2 GB box on 16.10).
# Agents and their builds live in this unit's cgroup. systemd's default
# OOMPolicy=stop tears down the WHOLE unit — the daemon and every chat's agent —
# when the kernel OOM-kills any one of them; with `continue` only the killed
# build dies. earlyoom (install.sh, "Early OOM killer") stops the heaviest
# process before the kernel has to; it spares this daemon by its process name
# (uno-work-daemon, see the launcher in install.sh).
# No OOMScoreAdjust here: oom_score_adj is inherited at fork, so a negative
# value would shield every agent and build the daemon starts as well — the
# kernel would then pick the person's own programs, ssh sessions and
# containers first.
OOMPolicy=continue

# The agent legitimately writes all over the user's home, so the sandbox is
# deliberately narrow: protect the OS, not the workspace.
NoNewPrivileges=true
ProtectSystem=full
# Off for the assistant sandbox: bubblewrap mounts a fresh /proc for a
# restricted assistant's agent, and the read-only overmounts this option puts
# on /proc make the kernel refuse that mount. The daemon is not root, so
# /proc/sys stays read-only to it either way.
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
PrivateTmp=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=uno-work

[Install]
WantedBy=multi-user.target
